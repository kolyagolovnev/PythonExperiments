# Copy to .env and adjust. All variables are optional; defaults are shown.
SECRET=change_this_to_a_strong_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=3600
PASSWORD_HASH_ROUNDS=12
MEDIA_MAX_BYTES=5000000
ADMINS_FILE=admins.json
# Empty -> in-memory repositories (data is lost on restart).
# Set to a SQLAlchemy async URL to enable the PostgreSQL layer, e.g. the
# db service from docker compose:
# DATABASE_URL=postgresql+asyncpg://vkazarme:vkazarme@localhost:5433/vkazarme
DATABASE_URL=
